# Default access-control config. Ships with mode: disabled so the store
# behaves identically to prior versions until an operator opts in.
#
# See docs/design/access-control.md for the full schema and the operator
# quickstart (provision a user via ./scripts/setup_user.py, then switch
# mode to 'standalone').

mode: standalone

# Publish skills for `npx skills add` (docs/design/npx.md).
# Serves SKILL.md CONTENT — not just metadata — to anyone holding a per-skill
# install URL, with no session (§4.3.3). One skill per URL; the URL's ref grants
# that skill only.
#
# Three values, independent of `mode` above:
#   true        every visible skill is publishable
#   false       nothing is; the /pub routes are not registered at all
#   selective   each skill's own `npx_publish` flag decides (the DEFAULT when
#               this key is absent). A skill that has not set it is NOT
#               published, so skills are opted in deliberately — edit one with
#               `PUT /skills/{name}` or the toggle on its page in the UI.
#
# `true`/`false` ignore the per-skill flag, so either one publishes or withdraws
# the whole store in a single edit.
#
# This shipped config is `mode: disabled`, where nothing is protected anyway, so
# it ships `true` to make a bare dev checkout usable out of the box.
npx_publish: true

unauthenticated_paths:
  - GET /health
  - GET /health/ready
  - GET /admin/metrics
  - POST /auth/login
  - POST /auth/logout
  - GET /auth/whoami
  - GET /docs
  - GET /openapi.json
  - GET /redoc
  # Root redirect and SPA deep-links → /ui: public, no auth needed.
  - GET /
  - GET /ui*
  - HEAD /ui*
  - GET /control_sse*
  - POST /control_sse*
  # Per-skill discovery for `npx skills add` (docs/design/npx.md §4.3.8).
  # Read-only, one skill per URL, gated by `npx_publish` above — when that is
  # off the routes are not registered at all and this entry matches nothing.
  # The path segment is a scoped capability token that resolves to a tenant and
  # is re-authorized on every request, so it stops working the moment that
  # tenant loses `skills:list`.
  # NOTE: `_path_matches` supports only a trailing '*' — a middle wildcard like
  # /pub/*/.well-known/* is inexpressible, so /pub/ MUST remain a dedicated
  # prefix with nothing else ever mounted under it (§5.10 #1).
  - GET /pub/*
  # CLI download (docs/design/new_cli.md §5.5). A browser, `curl`, CI or a
  # freshly downloaded binary has no token to offer, and a user who cannot sign
  # in yet is exactly the user who wants the CLI. It serves no tenant data, no
  # config and no login message, and accepts no request body.
  # HEAD is listed alongside GET because /cli/download serves both, and because
  # HEAD is how a client reads the artifact's sha256 without transferring it.
  - GET /cli*
  - HEAD /cli*

# --- Mode-specific: standalone only -------------------------------------
standalone:
  session_ttl_seconds: 43200          # 12h; env: SBS_SESSION_TTL
  users:
    - username: skillberry
      tenant_id: skillberry
      password_hash: '$2b$12$z1CKK7qHY.6ZlEAHbKBfDO5s/mWZin.SpU.iHyseaeOkUeOIqZZc2'
      groups: []
    - username: skillberry-admin
      tenant_id: skillberry-admin
      password_hash: '$2b$12$ssgkuUTSeR5B6mAJyoNm2udcEs2DcX5Kq4XuTYUnqrx3hO/DBy67e'
      groups: []

  # Informational message shown at login (UI sign-in screen and `sbs login`).
  # Both controls are independent: `enabled` gates the display, `message` holds
  # the text, so a message can be committed, and dressed, ahead of being switched on.
  # `format` picks the presentation: `plain` (the default — one string, shown
  # verbatim, 1024 chars / 10 lines) or `rich`, which adds Markdown-flavoured
  # markup plus a `style` block for the UI banner's own chrome and raises the cap
  # to 8192 chars / 40 lines. `sbs login` and GET /auth/whoami get plain text
  # either way. See docs/design/login-info.md and docs/design/login-banner.md.
  #
  # WARNING: this message is served PRE-AUTHENTICATION to anyone who can reach
  # /ui/ or GET /auth/whoami. It must contain NO SECRETS. That it sits in the
  # same file as the bcrypt password hashes does not make it confidential.
  #
  # login_info:
  #   enabled: false
  #   message: |
  #     This is a shared evaluation deployment — do not store secrets here.
  #     Access requests: ops@example.com
  #
  # The same notice as a rich banner:
  #
  # login_info:
  #   enabled: false
  #   format: rich
  #   style:
  #     background: "#fff4e5"
  #     text_color: "#4a3a1a"
  #     border_color: "#e0a63c"
  #     border_width: 2
  #     radius: 10
  #     padding: md
  #     icon: warning
  #   message: |
  #     ## [Shared evaluation deployment]{color=#a8600a bold}
  #     Do not store secrets here.
  #     Access requests: [ops@example.com](mailto:ops@example.com)

# --- RBAC ---------------------------------------------------------------
roles:
  - name: reader
    rules:
      - resources: [skills, tools, snippets, vmcp_servers, vnfs_servers,
                    facets, plugins, system]
        verbs: [list, get, search]

  - name: content-author
    rules:
      - resources: [skills, tools, snippets]
        verbs: [list, get, search, create, update, delete]

  - name: tool-runner
    rules:
      - resources: [tools, vmcp_servers, vnfs_servers]
        verbs: [execute]

  - name: server-operator
    rules:
      - resources: [vmcp_servers, vnfs_servers]
        verbs: [list, get, create, update, delete, execute]

  - name: admin
    rules:
      - resources: ["*"]
        verbs: ["*"]

  - name: base-user
    rules:
      - resources: [skills, tools, snippets, vmcp_servers, vnfs_servers,
                    facets, plugins, system]
        verbs: [list, get, search, execute]


  # Identity a plugin's autonomous work runs as (plugin-identity §5.3). Content
  # authorship, tool execution and virtual-server publication — nothing more. It
  # never mentions the `admin` resource, so /admin/backup, /admin/restore and
  # /admin/purge-all are out of reach by construction rather than by omission.
  - name: plugin-agent
    rules:
      - resources: [skills, tools, snippets]
        verbs: [list, get, search, create, update, delete]
                                                     # delete: `simulate` removes
                                                     # the sim skill/tools it
                                                     # created, on teardown
      - resources: [tools]
        verbs: [execute]                             # StoreAPI.execute_tool —
                                                     # dast's benign twin runs the
                                                     # skill's own tools through
                                                     # the store's execution path
      - resources: [vmcp_servers, vnfs_servers]
        verbs: [list, get, create, update, delete, execute]
                                                     # execute == start; this is
                                                     # what export over vNFS /
                                                     # WebDAV / vMCP requires
      - resources: [facets, plugins]
        verbs: [list, get, search]

bindings:
  - name: skillberry-base
    subjects:
      - kind: tenant
        name: skillberry
    roles: [base-user]

  - name: skillberry-admin
    subjects:
      - kind: tenant
        name: skillberry-admin
    roles: [admin]

  # `plugin-user` is deliberately a VIRTUAL subject: it appears in roles and
  # bindings so its grants are reviewable in the same file as every other grant,
  # but it has NO `standalone.users` entry — therefore no password hash, and no
  # way to log in from the network. `POST /auth/login` as plugin-user returns
  # invalid_credentials like any unknown user, so the identity is unforgeable
  # from outside: no credential for it exists anywhere.
  - name: plugin-agent-binding
    subjects:
      - kind: tenant
        name: plugin-user
    roles: [plugin-agent]

# --- Plugin identity ----------------------------------------------------
# Deployment-wide fallback identity for plugin work that no per-plugin owner
# covers. Precedence: the owner recorded when a tenant enabled the plugin (see
# PATCH /plugins/{name}) -> this -> none, in which case the plugin's outward
# calls FAIL rather than proceeding anonymously (P5).
#
# Shipping a default matters: with triggers running as the owner tenant, a
# deployment with no default has seven auto-triggering plugins whose first
# import fails silently on the event path.
plugins:
  owner_tenant: plugin-user
  # Groups to attribute to the owner tenant (it has no users entry of its own).
  owner_groups: []
  # Tokens minted for a plugin's out-of-process calls are short-lived and
  # refreshed on demand rather than held for a session's lifetime.
  token_ttl_seconds: 900
